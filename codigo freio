// =======================
// PINOS DOS MOTORES
// =======================
const int IN1 = 4;
const int IN2 = 7;
const int IN3 = 8;
const int IN4 = 12;

const int ENA = 5; // motor direito
const int ENB = 6; // motor esquerdo

// =======================
// SENSORES DE LINHA
// Ordem física:
// esquerda extrema, esquerda, meio, direita, direita extrema
// =======================
const int IRL2  = A0;
const int IRL1  = A1;
const int IRMID = A2;
const int IRR1  = A3;
const int IRR2  = A4;

const int IRBACK = 3;

// Botão de start
const int START_BUTTON = 2;

// =======================
// CONFIGURAÇÕES
// =======================
const int SENSOR_ATIVO = LOW;

// Velocidades
int baseSpeed   = 150;
int maxSpeed    = 240;
int searchSpeed = 140;

// =======================
// PID
// =======================
float Kp = 28.0;
float Ki = 0.0;
float Kd = 55.0;

// Boost extra nas curvas fortes
int curveBoost = 45;

// =======================
// SENSOR TRASEIRO
// =======================
unsigned long startTime = 0;

// Sensor traseiro só começa a valer
// 19 segundos depois da largada
unsigned long delayIRBack = 19000;

// Tempo entre detectar a linha final
// e realmente aplicar o freio
unsigned long delayParada = 300;

bool paradoPeloSensorBack = false;
bool roboLiberado = false;

// =======================
// VARIÁVEIS PID
// =======================
float erro = 0;
float erroAnterior = 0;
float integral = 0;
float ultimoErroValido = 0;

// Pesos dos sensores
// esquerda negativa / direita positiva
float pesos[5] = {
  -2,
  -1,
   0,
   1,
   2
};

// Ordem dos sensores
int sensores[5] = {
  IRL2,
  IRL1,
  IRMID,
  IRR1,
  IRR2
};


// =====================================================
// SETUP
// =====================================================
void setup() {

  // -----------------------
  // Motores
  // -----------------------
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);

  // -----------------------
  // Sensores
  // -----------------------
  pinMode(IRMID, INPUT);
  pinMode(IRL1, INPUT);
  pinMode(IRL2, INPUT);
  pinMode(IRR1, INPUT);
  pinMode(IRR2, INPUT);

  pinMode(IRBACK, INPUT);

  // -----------------------
  // Botão
  // -----------------------
  pinMode(START_BUTTON, INPUT_PULLUP);

  // Garante que começa parado
  stopMotors();


  // =======================
  // ESPERA APERTAR START
  // =======================
  while (digitalRead(START_BUTTON) == HIGH) {

    stopMotors();
  }


  // =======================
  // DELAY DE LARGADA
  // =======================
  delay(3000);


  // Marca o momento real da largada
  startTime = millis();

  roboLiberado = true;
}


// =====================================================
// LOOP
// =====================================================
void loop() {

  // =======================
  // SEGURANÇA
  // =======================
  if (!roboLiberado) {

    stopMotors();

    return;
  }


  // =======================
  // JÁ PAROU NA LINHA FINAL
  // =======================
  if (paradoPeloSensorBack) {

    // Mantém freio motor aplicado
    brakeMotors();

    return;
  }


  // =======================
  // SENSOR TRASEIRO
  // =======================
  int BACK = digitalRead(IRBACK);


  // Só começa a verificar o sensor
  // depois de 19 segundos
  if (millis() - startTime >= delayIRBack) {

    if (BACK == SENSOR_ATIVO) {

      // =====================================
      // LINHA FINAL DETECTADA
      // =====================================

      // Continua com o último comando
      // dos motores durante 500 ms
      delay(delayParada);


      // Depois dos 500 ms
      // aplica o freio motor
      brakeMotors();


      // Trava o estado como parado
      paradoPeloSensorBack = true;

      return;
    }
  }


  // =======================
  // CONTROLE DE LINHA
  // =======================
  bool linhaEncontrada = false;

  erro = lerErroLinha(linhaEncontrada);


  if (linhaEncontrada) {

    aplicarPID();
  }

  else {

    procurarLinha();
  }


  delay(10);
}


// =====================================================
// LEITURA DA LINHA
// =====================================================
float lerErroLinha(bool &linhaEncontrada) {

  float somaPesos = 0;

  int sensoresAtivos = 0;


  // Percorre os 5 sensores
  for (int i = 0; i < 5; i++) {

    if (digitalRead(sensores[i]) == SENSOR_ATIVO) {

      somaPesos += pesos[i];

      sensoresAtivos++;
    }
  }


  // =======================
  // LINHA ENCONTRADA
  // =======================
  if (sensoresAtivos > 0) {

    linhaEncontrada = true;


    float posicao =
      somaPesos / sensoresAtivos;


    ultimoErroValido = posicao;


    return posicao;
  }


  // =======================
  // LINHA PERDIDA
  // =======================
  else {

    linhaEncontrada = false;


    return ultimoErroValido;
  }
}


// =====================================================
// PID
// =====================================================
void aplicarPID() {

  // -----------------------
  // Proporcional
  // -----------------------
  float proporcional = erro;


  // -----------------------
  // Integral
  // -----------------------
  integral += erro;

  integral = constrain(
    integral,
    -30,
    30
  );


  // -----------------------
  // Derivativo
  // -----------------------
  float derivativo =
    erro - erroAnterior;


  // -----------------------
  // Correção PID
  // -----------------------
  float correcao =
    (Kp * proporcional) +
    (Ki * integral) +
    (Kd * derivativo);


  erroAnterior = erro;


  // =======================
  // BOOST EM CURVAS FORTES
  // =======================
  if (erro >= 1.5) {

    correcao += curveBoost;
  }

  else if (erro <= -1.5) {

    correcao -= curveBoost;
  }


  // =======================
  // VELOCIDADE DOS MOTORES
  // =======================

  // Linha para direita:
  // esquerdo acelera
  // direito reduz

  int motorEsq =
    baseSpeed + correcao;

  int motorDir =
    baseSpeed - correcao;


  // Limites
  motorEsq = constrain(
    motorEsq,
    0,
    maxSpeed
  );

  motorDir = constrain(
    motorDir,
    0,
    maxSpeed
  );


  // Envia para motores
  setMotors(
    motorEsq,
    motorDir
  );
}


// =====================================================
// BUSCA QUANDO PERDE A LINHA
// =====================================================
void procurarLinha() {

  // Zera integral para evitar
  // acúmulo durante a busca
  integral = 0;


  // =======================
  // LINHA ESTAVA À DIREITA
  // =======================
  if (ultimoErroValido > 0) {

    // Motor esquerdo anda
    // Motor direito para

    setMotors(
      searchSpeed,
      0
    );
  }


  // =======================
  // LINHA ESTAVA À ESQUERDA
  // =======================
  else if (ultimoErroValido < 0) {

    // Motor direito anda
    // Motor esquerdo para

    setMotors(
      0,
      searchSpeed
    );
  }


  // =======================
  // NÃO SABE PARA ONDE IR
  // =======================
  else {

    // Procura para direita

    setMotors(
      searchSpeed,
      0
    );
  }
}


// =====================================================
// CONTROLE NORMAL DOS MOTORES
// =====================================================
void setMotors(int velEsq, int velDir) {

  // =======================
  // MOTOR DIREITO
  // =======================

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);


  // =======================
  // MOTOR ESQUERDO
  // =======================

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);


  // ENA = motor direito
  analogWrite(
    ENA,
    velDir
  );


  // ENB = motor esquerdo
  analogWrite(
    ENB,
    velEsq
  );
}


// =====================================================
// PARADA NORMAL
// =====================================================
void stopMotors() {

  // Desliga direção
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);


  // Desabilita os motores
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);
}


// =====================================================
// FREIO MOTOR
// =====================================================
void brakeMotors() {

  /*
     FREIO DINÂMICO

     Os dois terminais de cada motor ficam
     no mesmo estado enquanto a ponte H
     permanece habilitada.

     Isso cria resistência elétrica contra
     a própria rotação do motor e reduz
     bastante a inércia do robô.
  */


  // =======================
  // MOTOR DIREITO
  // =======================

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);


  // =======================
  // MOTOR ESQUERDO
  // =======================

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);


  // Mantém ponte habilitada
  // para aplicar o freio
  analogWrite(ENA, 255);
  analogWrite(ENB, 255);
}
